(footprint "Jack_RCA_SameSky_RCJ-02_Vertical"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "RCA jack, vertical, through hole, Same Sky (CUI) RCJ-02x (RCJ-025 = blue, LCSC C4991609). Recommended PCB layout from the datasheet (rev 1.05, 06/25/2026): bracket holes 2 x d2.00 at 10.30 apart (sleeve), centre terminal d1.70 offset 1.60 from the bracket line (tip). Body d8.30, 10.70 x 10.00 seen from the top, legs 12.65 wide, front face 22.1 mm above the board. No panel nut: the board holds the jack.")
  (tags "rca phono jack vertical RCJ-02 RCJ-025")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -8.2) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "RCJ-02" (at 0 5.2) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_circle (center 0 -1.6) (end 4.15 -1.6) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -5.35 -6.6) (end 5.35 3.4) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -5.47 -6.72) (end 5.47 3.52) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -6.6 -7.0) (end 6.6 3.8) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "T" thru_hole circle (at 0 -1.6) (size 2.6 2.6) (drill 1.7) (layers "*.Cu" "*.Mask"))
  (pad "S" thru_hole circle (at -5.15 0) (size 3.0 3.0) (drill 2.0) (layers "*.Cu" "*.Mask"))
  (pad "S" thru_hole circle (at 5.15 0) (size 3.0 3.0) (drill 2.0) (layers "*.Cu" "*.Mask"))
)
