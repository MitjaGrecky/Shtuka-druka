(export (version "E")
  (design (source "design.py") (tool "tools/pack_easyeda.py design_netlist"))
  (components
    (comp (ref "J1") (value "USB4105-GF-A") (footprint "Connector_USB:USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal"))
    (comp (ref "J2") (value "to PW J2") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x06_P2.54mm_Vertical"))
    (comp (ref "R1") (value "1M") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "C1") (value "1n") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "H1") (value "M3") (footprint "MountingHole:MountingHole_3.2mm_M3_ISO7380"))
    (comp (ref "H2") (value "M3") (footprint "MountingHole:MountingHole_3.2mm_M3_ISO7380"))
  )
  (nets
    (net (code "1") (name "/PD_CC1")
      (node (ref "J1") (pin "A5"))
      (node (ref "J2") (pin "5"))
    )
    (net (code "2") (name "/PD_CC2")
      (node (ref "J1") (pin "B5"))
      (node (ref "J2") (pin "6"))
    )
    (net (code "3") (name "/PD_VBUS")
      (node (ref "J1") (pin "A4"))
      (node (ref "J1") (pin "B4"))
      (node (ref "J1") (pin "A9"))
      (node (ref "J1") (pin "B9"))
      (node (ref "J2") (pin "1"))
      (node (ref "J2") (pin "2"))
    )
    (net (code "4") (name "/SHIELD")
      (node (ref "J1") (pin "SH"))
      (node (ref "R1") (pin "1"))
      (node (ref "C1") (pin "1"))
    )
    (net (code "5") (name "GND")
      (node (ref "J1") (pin "A1"))
      (node (ref "J1") (pin "B1"))
      (node (ref "J1") (pin "A12"))
      (node (ref "J1") (pin "B12"))
      (node (ref "J2") (pin "3"))
      (node (ref "J2") (pin "4"))
      (node (ref "R1") (pin "2"))
      (node (ref "C1") (pin "2"))
    )
  )
)
