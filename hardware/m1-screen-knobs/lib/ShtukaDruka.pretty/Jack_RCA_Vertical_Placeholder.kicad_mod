(footprint "Jack_RCA_Vertical_Placeholder"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Placeholder for a vertical RCA jack with a nut (part not chosen yet, R1): signal pad T and sleeve pad S, 5 mm apart, 1.4 mm drills")
  (tags "rca placeholder")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -8) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "RCA placeholder" (at 0 8) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_circle (center 0 0) (end 6 0) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 6.25 0) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "T" thru_hole circle (at 0 0) (size 2.4 2.4) (drill 1.4) (layers "*.Cu" "*.Mask"))
  (pad "S" thru_hole circle (at 5 0) (size 2.4 2.4) (drill 1.4) (layers "*.Cu" "*.Mask"))
)
