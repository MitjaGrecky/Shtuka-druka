(footprint "Jack_6.35mm_Cliff_S1_Horizontal"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "6.35 mm (1/4 in) stereo jack, switched, Cliff S1/BBB (CL1115, Digikey 4654-CL1115-ND), horizontal, nose towards -y. Pads from the Cliff drawing CL1115 (issue 1, 25/04/17): 6 holes d1.60, 6.35 pitch along the plug axis, 11.40 across; pins 4/5/6 are the spring contacts the plug makes (sleeve, ring, tip), 1/2/3 the break contacts (sleeve, ring, tip normals). Pad names follow the KiCad AudioJack3_Switch symbol: S/R/T = pins 4/5/6, SN/RN/TN = pins 1/2/3. Body 15.9 wide, 12.70 high, axis 6.50 above the board, overall 33.60 long: thread 9.35 (7/16 in UNF, nut 5.0 + fibre washer 1.6) in front of the mounting face, first pad row 4.25 behind it. Wall 3 mm + washer 1.6 + nut 5.0 = 9.6 > 9.35: leave the washer out or thin the wall at the jack.")
  (tags "jack 6.35mm cliff S1 CL1115 stereo switched horizontal")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 22.2) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "Cliff S1 CL1115" (at 0 -15.8) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_rect (start -7.95 -4.25) (end 7.95 20.0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -5.55 -13.6) (end 5.55 -4.25) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -8.1 -4.4) (end 8.1 20.15) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_line (start -5.7 -4.4) (end -5.7 -13.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 5.7 -4.4) (end 5.7 -13.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_rect (start -8.5 -14.1) (end 8.5 20.5) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_text user "S R T" (at -5.7 -2.0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text user "make 4 5 6" (at -5.7 15.4) (layer "F.Fab") (effects (font (size 0.7 0.7) (thickness 0.1))))
  (fp_text user "break 1 2 3" (at 5.7 15.4) (layer "F.Fab") (effects (font (size 0.7 0.7) (thickness 0.1))))
  (pad "S" thru_hole circle (at -5.7 0) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))
  (pad "R" thru_hole circle (at -5.7 6.35) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))
  (pad "T" thru_hole circle (at -5.7 12.7) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))
  (pad "SN" thru_hole circle (at 5.7 0) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))
  (pad "RN" thru_hole circle (at 5.7 6.35) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))
  (pad "TN" thru_hole circle (at 5.7 12.7) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))
)
